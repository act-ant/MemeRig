{
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "scripts": {
    "prepare": "husky",
    "build": "pnpm --filter memerig-core build && pnpm --filter memerig build",
    "build:core": "pnpm --filter memerig-core build",
    "build:cli": "pnpm --filter memerig build",
    "test": "pnpm --filter memerig-core test && pnpm --filter memerig test",
    "test:core": "pnpm --filter memerig-core test",
    "test:cli": "pnpm --filter memerig test",
    "lint": "pnpm --filter memerig-core lint && pnpm --filter memerig lint",
    "typecheck": "pnpm --filter memerig-core build && pnpm --filter memerig typecheck",
    "release": "pnpm --filter memerig release",
    "release:minor": "pnpm --filter memerig release:minor",
    "release:major": "pnpm --filter memerig release:major",
    "release:beta": "pnpm --filter memerig release:beta",
    "release:rc": "pnpm --filter memerig release:rc",
    "release:promote": "pnpm --filter memerig release:promote",
    "release:check": "node packages/cli/scripts/release-preflight.js check-versions",
    "release:plan": "node packages/cli/scripts/release-preflight.js publish-plan"
  },
  "devDependencies": {
    "husky": "^9.1.7",
    "lint-staged": "^16.2.7"
  }
}
